{
  "name": "@app-deporte/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file .env.local src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "docs:export": "tsx src/scripts/export-openapi.ts",
