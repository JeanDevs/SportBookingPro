<mxfile host="drawio" agent="SportBook Pro diagram generator"><diagram name="01 Arquitectura 3 capas MVC" id="838592352381146398"><mxGraphModel dx="1500" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:20px"&gt;SportBook Pro — Arquitectura de tres capas (patrón MVC)&lt;/b&gt;&lt;br&gt;Next.js 15 (App Router) desplegado en Vercel · Supabase (PostgreSQL 15)' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;(desktop / móvil)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="68" width="260" height="55" as="geometry"/></mxCell><mxCell id="c5" value="Administrador&lt;br&gt;(dueño)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="55" width="36" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Cliente&lt;br&gt;(jugador)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="55" width="36" height="70" as="geometry"/></mxCell><mxCell id="c7" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=none;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="CAPA 1 · PRESENTACIÓN  —  Vista (V)        Next.js App Router · React 19 · TypeScript · TailwindCSS" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=14;container=1;collapsible=0;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1080" height="190" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Páginas (Server Components)&lt;/b&gt;&lt;br&gt;&lt;i&gt;page.tsx&lt;/i&gt;&lt;br&gt;/panel · /panel/reservas · /panel/pagos&lt;br&gt;/panel/reportes · /c/[slug] · /cuenta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c9"><mxGeometry x="20" y="48" width="320" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Vistas interactivas (Client Components)&lt;/b&gt;&lt;br&gt;&lt;i&gt;*-view.tsx&lt;/i&gt;&lt;br&gt;ReservasView · PagosView&lt;br&gt;ReportesView · BookingView" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c9"><mxGeometry x="380" y="48" width="320" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Componentes UI reutilizables&lt;/b&gt;&lt;br&gt;&lt;i&gt;components/ui · components/panel&lt;/i&gt;&lt;br&gt;Button · Card · StatCard · Modal&lt;br&gt;OwnerShell (menú lateral)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c9"><mxGeometry x="740" y="48" width="320" height="120" as="geometry"/></mxCell><mxCell id="c13" value="CAPA 2 · LÓGICA DE NEGOCIO  —  Controlador (C) + Modelo (M)        servidor Next.js (Node.js) · Vercel Serverless Functions" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=14;container=1;collapsible=0;rounded=1;arcSize=2;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1080" height="400" as="geometry"/></mxCell><mxCell id="c14" value="Controlador (C)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=14;container=1;collapsible=0;rounded=1;arcSize=2;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="c13"><mxGeometry x="20" y="45" width="1040" height="150" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;middleware.ts&lt;/b&gt;&lt;br&gt;Autenticación y control de acceso por zonas&lt;br&gt;(público · cliente · dueño)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c14"><mxGeometry x="15" y="42" width="320" height="92" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Server Actions&lt;/b&gt; (&lt;i&gt;'use server'&lt;/i&gt;)&lt;br&gt;createReservation · cancelReservation&lt;br&gt;validatePayment · rejectPayment&lt;br&gt;createBooking · createCustomer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c14"><mxGeometry x="360" y="42" width="320" height="92" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Route Handlers&lt;/b&gt;&lt;br&gt;GET /panel/reportes/exportar&lt;br&gt;GET /auth/callback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c14"><mxGeometry x="705" y="42" width="320" height="92" as="geometry"/></mxCell><mxCell id="c18" value="Modelo (M)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=14;container=1;collapsible=0;rounded=1;arcSize=2;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="c13"><mxGeometry x="20" y="215" width="1040" height="170" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Servicios de dominio&lt;/b&gt;&lt;br&gt;&lt;i&gt;services/*.ts&lt;/i&gt;&lt;br&gt;reservations · payments · customers&lt;br&gt;fields · dashboard · &lt;b&gt;reports&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="15" y="42" width="240" height="112" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Reglas y tipos de dominio&lt;/b&gt;&lt;br&gt;&lt;i&gt;lib/domain.ts · validators.ts&lt;/i&gt;&lt;br&gt;&lt;i&gt;slots.ts · format.ts&lt;/i&gt;&lt;br&gt;estados, montos, horario Lima" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="275" y="42" width="240" height="112" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Exportadores de reportes&lt;/b&gt;&lt;br&gt;&lt;i&gt;lib/reports&lt;/i&gt;&lt;br&gt;ReportExporter (Strategy)&lt;br&gt;PDF · Excel · CSV + ExporterFactory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="535" y="42" width="240" height="112" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Acceso a datos&lt;/b&gt;&lt;br&gt;&lt;i&gt;lib/supabase/server.ts&lt;/i&gt;&lt;br&gt;createClient(): cliente SSR&lt;br&gt;sesión en cookies httpOnly" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="795" y="42" width="230" height="112" as="geometry"/></mxCell><mxCell id="c23" value="CAPA 3 · DATOS        Supabase · PostgreSQL 15 gestionado en la nube" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fontStyle=1;fontSize=14;container=1;collapsible=0;rounded=1;arcSize=2;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1080" height="210" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Tablas de negocio&lt;/b&gt;&lt;br&gt;facilities · fields · customers&lt;br&gt;reservations · payments&lt;br&gt;status_history · audit_logs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c23"><mxGeometry x="20" y="48" width="195" height="140" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Seguridad en BD&lt;/b&gt;&lt;br&gt;Row Level Security&lt;br&gt;&lt;i&gt;owner_id = auth.uid()&lt;/i&gt;&lt;br&gt;aislamiento multi-tenant" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c23"><mxGeometry x="230" y="48" width="195" height="140" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Reglas en BD&lt;/b&gt;&lt;br&gt;EXCLUDE GiST anti-solapamiento&lt;br&gt;trigger validate_reservation_business_rules&lt;br&gt;pg_cron: expira reservas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c23"><mxGeometry x="440" y="48" width="205" height="140" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Funciones RPC&lt;/b&gt; (SECURITY DEFINER)&lt;br&gt;create_customer_booking&lt;br&gt;public_field_slots&lt;br&gt;submit_customer_payment_proof" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c23"><mxGeometry x="660" y="48" width="205" height="140" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Supabase Auth&lt;/b&gt; (JWT)&lt;br&gt;&lt;br&gt;&lt;b&gt;Supabase Storage&lt;/b&gt;&lt;br&gt;(comprobantes de pago)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c23"><mxGeometry x="880" y="48" width="180" height="140" as="geometry"/></mxCell><mxCell id="c29" value="HTTPS (petición)" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="acción del usuario&lt;br&gt;(Server Action / GET exportar)" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="HTML / RSC renderizado,&lt;br&gt;archivo PDF · XLSX · CSV" style="html=1;rounded=0;fontFamily=Helvetica;dashed=1;endArrow=open;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.65;exitY=0;exitDx=0;exitDy=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="supabase-js (PostgREST / RPC)&lt;br&gt;con JWT del usuario" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="filas filtradas por RLS" style="html=1;rounded=0;fontFamily=Helvetica;dashed=1;endArrow=open;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.65;exitY=0;exitDx=0;exitDy=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;Correspondencia con MVC&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;V · Vista&lt;/b&gt;: páginas y componentes React (Capa 1).&lt;br&gt;&lt;br&gt;&lt;b&gt;C · Controlador&lt;/b&gt;: middleware, Server Actions y Route Handlers reciben la acción, validan sesión y parámetros y deciden qué modelo invocar.&lt;br&gt;&lt;br&gt;&lt;b&gt;M · Modelo&lt;/b&gt;: servicios de dominio, reglas, exportadores y acceso a datos (Capa 2) apoyados en la base de datos (Capa 3)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="170" width="310" height="215" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Separación física de capas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Capa 1 → navegador del usuario&lt;br&gt;Capa 2 → Vercel (funciones serverless Node.js)&lt;br&gt;Capa 3 → Supabase (servidor PostgreSQL)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="470" width="310" height="105" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;apps/api (Fastify)&lt;/b&gt;&lt;br&gt;Existe en el monorepo con el módulo de autenticación; reservado para integraciones futuras. &lt;b&gt;No interviene&lt;/b&gt; en el flujo actual." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1150" y="630" width="310" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>