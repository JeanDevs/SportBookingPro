<mxfile host="drawio" agent="SportBook Pro diagram generator"><diagram name="14 Patrones de diseño" id="6472174906775521943"><mxGraphModel dx="1600" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:18px"&gt;Diagrama de clases de diseño — Patrones aplicados en SportBook Pro&lt;/b&gt;&lt;br&gt;Strategy + Factory Method (reportes) · Service Layer + DTO (modelo) · Middleware (cadena de filtros)' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="1300" height="46" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Strategy + Factory Method&lt;/b&gt; — módulo de reportes exportables (lib/reports)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1000" height="640" as="geometry"/></mxCell><mxCell id="c5" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«control · Context / Client»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;GET exportar&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ GET(request): Response&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="270" height="86" as="geometry"/></mxCell><mxCell id="c6" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«Factory»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;ExporterFactory&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;- registry: Record‹ReportFormat, () → ReportExporter›&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ create(format): ReportExporter&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ supportedFormats(): ReportFormat[]&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="300" height="100" as="geometry"/></mxCell><mxCell id="c7" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«interface · Strategy»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;&lt;i&gt;ReportExporter&lt;/i&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ format: ReportFormat&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ contentType: string&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ extension: string&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ export(data: ReportData): Promise‹Uint8Array | string›&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="330" height="114" as="geometry"/></mxCell><mxCell id="c8" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«ConcreteStrategy»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;PdfExporter&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;format = &amp;#x27;pdf&amp;#x27;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ export(data): Promise‹bytes›&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="205" height="86" as="geometry"/></mxCell><mxCell id="c9" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«ConcreteStrategy»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;ExcelExporter&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;format = &amp;#x27;xlsx&amp;#x27;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ export(data): Promise‹bytes›&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="420" width="205" height="86" as="geometry"/></mxCell><mxCell id="c10" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«ConcreteStrategy»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;CsvExporter&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;format = &amp;#x27;csv&amp;#x27;&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;- delimiter: &amp;#x27;,&amp;#x27; | &amp;#x27;;&amp;#x27;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ export(data): Promise‹bytes›&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="420" width="205" height="100" as="geometry"/></mxCell><mxCell id="c11" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«DTO»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;ReportData&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ title: string&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ subtitle: string&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ generatedAt: string&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ columns: ReportColumn[]&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ rows: ReportRow[]&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ totals?: ReportRow&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="300" height="133" as="geometry"/></mxCell><mxCell id="c12" value="usa" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="createExporter(formato)" style="html=1;rounded=0;fontFamily=Helvetica;dashed=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=0;dashed=1;endSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=0;dashed=1;end