l id="c21" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«Service Layer · &amp;#x27;use server&amp;#x27;»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;reservations (service)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ listDayReservations(fecha): OwnerReservation[]&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ createReservation(input): Result&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ cancelReservation(id): Result&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="120" width="450" height="114" as="geometry"/></mxCell><mxCell id="c22" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«Service Layer»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;reports (service)&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ getReport(type, range): ReportData&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ getReservationsReport(range): ReportData&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ getIncomeReport(range): ReportData&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ getCustomersReport(range): ReportData&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="410" width="450" height="128" as="geometry"/></mxCell><mxCell id="c23" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«fila de BD»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;ResRow&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;start_at: string&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;total_amount: number | string&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;field_id: string&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="270" width="200" height="91" as="geometry"/></mxCell><mxCell id="c24" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«DTO»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;OwnerReservation&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;startAt: string&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;totalAmount: number&lt;/p&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;fieldName: string&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="270" width="200" height="91" as="geometry"/></mxCell><mxCell id="c25" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;font-size:10px;"&gt;«Factory · lib/supabase/server.ts»&lt;/p&gt;&lt;p style="margin:0px;margin-top:0px;text-align:center;"&gt;&lt;b&gt;createClient()&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+ createClient(): SupabaseClient&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="600" width="450" height="86" as="geometry"/></mxCell><mxCell id="c26" value="mapea" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="html=1;rounded=0;fontFamily=Helvetica;dashed=1;endArrow=open;endFill=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="html=1;rounded=0;fontFamily=Helvetica;dashed=1;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Middleware / Chain of Responsibility&lt;/b&gt; — controlador frontal (middleware.ts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="1540" height="230" as="geometry"/></mxCell><mxCell id="c30" value="Petición HTTP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="240" height="70" as="geometry"/></mxCell><mxCell id="c31" value="middleware.ts&lt;br&gt;&lt;i&gt;refresca sesión (cookies)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="810" width="240" height="70" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="¿Zona?&lt;br&gt;&lt;i&gt;público · cliente · dueño&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="810" width="240" height="70" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;" edge="1" parent="1" source="c31" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="¿Rol válido?&lt;br&gt;&lt;i&gt;account_type del JWT&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="810" width="240" height="70" as="geometry"/></mxCell><mxCell id="c36" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;" edge="1" parent="1" source="c33" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="Controlador&lt;br&gt;&lt;i&gt;Server Action / Route Handler&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="810" width="240" height="70" as="geometry"/></mxCell><mxCell id="c38" value="" style="html=1;rounded=0;fontFamily=Helvetica;endArrow=block;endFill=1;" edge="1" parent="1" source="c35" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="Si la sesión o el rol no corresponden, la cadena se corta y se redirige a /panel/ingresar o /ingresar (no llega al controlador)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Resumen&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Strategy&lt;/b&gt;: cada formato (PDF, Excel, CSV) es una estrategia intercambiable con la misma interfaz.&lt;br&gt;• &lt;b&gt;Factory Method&lt;/b&gt;: el controlador pide el exportador por formato sin conocer la clase concreta.&lt;br&gt;• &lt;b&gt;Service Layer&lt;/b&gt;: la lógica de negocio y el acceso a datos viven en servicios por módulo.&lt;br&gt;• &lt;b&gt;DTO / Data Mapper&lt;/b&gt;: las filas de la BD (snake_case) se transforman en objetos de vista (camelCase).&lt;br&gt;• &lt;b&gt;Middleware&lt;/b&gt;: filtro previo a todos los controladores para autenticación y autorización." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1000" width="1540" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>