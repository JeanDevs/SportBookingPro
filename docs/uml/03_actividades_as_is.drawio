kgroundColor=#ffffff;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="propone otro horario" style="html=1;rounded=0;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="902" y="495"/><mxPoint x="902" y="152"/><mxPoint x="287" y="152"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="html=1;rounded=0;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="588"/></Array></mxGeometry></mxCell><mxCell id="c25" value="" style="html=1;rounded=0;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;endSize=8;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="html=1;rounded=0;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;endSize=8;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="html=1;rounded=0;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;endSize=8;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="html=1;rounded=0;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;endSize=8;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="html=1;rounded=0;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;endSize=8;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;Problema:&lt;/b&gt; si el cuaderno no se actualiza a tiempo se produce &lt;b&gt;doble reserva&lt;/b&gt; (~3 conflictos/mes)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="255" width="330" height="80" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Problema:&lt;/b&gt; el proceso tarda &lt;b&gt;~8 minutos&lt;/b&gt; por reserva y se pierde ~20% de solicitudes sin respuesta oportuna." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="380" width="330" height="80" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Problema:&lt;/b&gt; no existe registro digital de pagos ni &lt;b&gt;reportes&lt;/b&gt; de ocupación o ingresos." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="660" width="330" height="80" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Problema:&lt;/b&gt; si el operador no está disponible, el proceso se &lt;b&gt;detiene&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="820" width="330" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>